# ===========================================================================
# Multilingual file for the TOS 7 Docker application "qbittorrentdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "qBittorrent"
auth         = "qbittorrent"
version      = "@@VERSION@@"
descript     = "qBittorrent is a BitTorrent client with a clean web UI: add magnet links or .torrent files, queue and seed, set speed limits, search and RSS. It runs as a non-root container, keeps settings and resume data in the app data folder, and writes downloads to a folder you control. The first start generates a random WebUI password in config/qBittorrent/webui-credentials.txt (0600). There is no account or telemetry, but the trackers, DHT nodes and peers of the torrents you add see your public IP."
release_note = "5.3.0-3 rectifies the review findings. F10: the container log no longer contains a plaintext WebUI password. Each installation generates a random password, stores the PBKDF2-HMAC-SHA512 hash in qBittorrent.conf and keeps the plaintext only in config/qBittorrent/webui-credentials.txt (0600). Change it after the first login and delete the file. F2/F8: the wrapper now seeds the image's /defaults/qBittorrent.conf instead of writing a minimal config, so Downloads\\SavePath is /downloads/ and UPnP is off. 5.3.0-2 fell back to /config/Downloads, which this update migrates. F3: stop_grace_period 30s. F7: HostHeaderValidation is disabled before start so the WebUI loads through 8041 and reverse proxies, while login and CSRF protection stay enabled. F11/F4: the README documents the data folders and the deletion steps. F9: restart policy and healthcheck re-verified. S11: umask 077, config and credentials 0600, cap_drop ALL, no-new-privileges and a uid-1000 tmpfs /run. C2: the licence is corrected to GPL-3.0-or-later for the binary (GPL-2.0-or-later source) and NOTICE is rewritten. C8: the third-party table lists every endpoint, what it sends and how to disable it, including tracker, DHT and peer public-IP exposure, the DB-IP download and the optional STUN, search and RSS endpoints. C10: the README now has repository layout, privacy, notices, build, data and uninstall sections. T1: the image moves to the 2026-11-23 build (5.3.0_v2.1.3-ls489, index digest a8083a33...). V7: deterministic rebuild and the platform file_hash is checked against the local SHA-256."
important    = "Requires DockerEngine. Log in as admin with the random password in DockerAppData/qbittorrentdocker/config/qBittorrent/webui-credentials.txt (0600), change it and delete the file. Downloads: DockerAppData/qbittorrentdocker/downloads, settings: .../config. Only the WebUI port is published, so incoming peers are limited. Your public IP is visible to the trackers, DHT nodes and peers of every torrent you add, and no VPN is included. Plain HTTP. Use a TLS reverse proxy before exposing it."

[zh-cn]
name         = "qBittorrent"
auth         = "qbittorrent"
version      = "@@VERSION@@"
descript     = "qBittorrent 是一款功能完整的 BT 客户端，自带清爽的网页界面：添加磁力链接或 .torrent、排队与做种、限速、搜索种子、RSS 订阅都可以在浏览器里完成。它以非 root 容器运行，设置与续传数据保存在应用数据目录，下载文件放在你指定的目录。首次启动会生成随机 WebUI 密码，保存在 config/qBittorrent/webui-credentials.txt（0600）。本应用没有账号与遥测，但你添加的每个任务对应的 tracker、DHT 节点与 peer 都会看到你的公网 IP。"
release_note = "5.3.0-3：按审核意见整改。F10：容器日志不再出现明文 WebUI 密码，每次安装生成随机密码，PBKDF2-HMAC-SHA512 哈希写入 qBittorrent.conf，明文只放在 config/qBittorrent/webui-credentials.txt（0600），首次登录后请修改并删除该文件。F2/F8：包装层改为复制镜像自带的 /defaults/qBittorrent.conf，下载路径恢复为 /downloads/、UPnP 保持关闭，并迁移 5.3.0-2 误写的 /config/Downloads。F3：增加 stop_grace_period 30s。F7：启动前关闭 HostHeaderValidation，使 8041 端口与反向代理下的页面正常加载，登录与 CSRF 防护保留。F11/F4：README 写明数据目录与删除步骤。F9：重启策略与健康检查复验。S11：umask 077，配置与凭据 0600，cap_drop ALL、no-new-privileges 与 uid 1000 的 tmpfs /run。C2：许可更正为二进制 GPL-3.0-or-later（源码 GPL-2.0-or-later），重写 NOTICE。C8：第三方表逐项列出端点、发送内容与关闭方法，含 tracker、DHT、peer 的公网 IP 暴露、DB-IP 下载与可选 STUN、搜索、RSS。C10：README 补齐目录、隐私、告示、构建、数据与卸载。T1：镜像升级到 2026-11-23 构建（5.3.0_v2.1.3-ls489，index digest a8083a33...）。V7：确定性重建并核对平台 file_hash 与本地 SHA-256。"
important    = "需要 DockerEngine。首次启动后，用 admin 和 DockerAppData/qbittorrentdocker/config/qBittorrent/webui-credentials.txt（0600）里的随机密码登录，登录后请修改密码并删除该文件。下载文件在 DockerAppData/qbittorrentdocker/downloads，设置在 .../config。只发布 WebUI 端口，入站 peer 连接受限。你添加的每个任务都会把公网 IP 暴露给对应的 tracker、DHT 节点和 peer，本包不含 VPN。界面为 HTTP，外网访问请配置带 TLS 的反向代理。"

[zh-hk]
name         = "qBittorrent"
auth         = "qbittorrent"
version      = "@@VERSION@@"
descript     = "qBittorrent 是一款功能完整的 BT 用戶端，自帶清爽的網頁介面：新增磁力連結或 .torrent、排隊與做種、限速、搜尋種子、RSS 訂閱都可以在瀏覽器裡完成。它以非 root 容器運行，設定與續傳資料保存在應用資料目錄，下載檔案放在你指定的目錄。首次啟動會產生隨機 WebUI 密碼，保存在 config/qBittorrent/webui-credentials.txt（0600）。本應用沒有帳號與遙測，但你新增的每個任務對應的 tracker、DHT 節點與 peer 都會看到你的公網 IP。"
release_note = "5.3.0-3：按審核意見整改。F10：容器日誌不再出現明文 WebUI 密碼，每次安裝產生隨機密碼，PBKDF2-HMAC-SHA512 雜湊寫入 qBittorrent.conf，明文只放在 config/qBittorrent/webui-credentials.txt（0600），首次登入後請修改並刪除該檔案。F2/F8：包裝層改為複製鏡像自帶的 /defaults/qBittorrent.conf，下載路徑恢復為 /downloads/、UPnP 保持關閉，並遷移 5.3.0-2 誤寫的 /config/Downloads。F3：增加 stop_grace_period 30s。F7：啟動前關閉 HostHeaderValidation，使 8041 端口與反向代理下的頁面正常載入，登入與 CSRF 防護保留。F11/F4：README 寫明資料目錄與刪除步驟。F9：重啟策略與健康檢查複驗。S11：umask 077，設定與憑據 0600，cap_drop ALL、no-new-privileges 與 uid 1000 的 tmpfs /run。C2：許可更正為二進位 GPL-3.0-or-later（原始碼 GPL-2.0-or-later），重寫 NOTICE。C8：第三方表逐項列出端點、傳送內容與關閉方法，含 tracker、DHT、peer 的公網 IP 暴露、DB-IP 下載與可選 STUN、搜尋、RSS。C10：README 補齊目錄、隱私、告示、建置、資料與卸載。T1：鏡像升級到 2026-11-23 建置（5.3.0_v2.1.3-ls489，index digest a8083a33...）。V7：確定性重建並核對平台 file_hash 與本地 SHA-256。"
important    = "需要 DockerEngine。首次啟動後，用 admin 和 DockerAppData/qbittorrentdocker/config/qBittorrent/webui-credentials.txt（0600）裡的隨機密碼登入，登入後請修改密碼並刪除該檔案。下載檔案在 DockerAppData/qbittorrentdocker/downloads，設定在 .../config。只發佈 WebUI 端口，入站 peer 連線受限。你新增的每個任務都會把公網 IP 暴露給對應的 tracker、DHT 節點和 peer，本包不含 VPN。介面為 HTTP，外網存取請配置帶 TLS 的反向代理。"

